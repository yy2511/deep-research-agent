# 复制为 .env 并只填写你实际使用的 provider。
# .env 已被 .gitignore 忽略，永不提交；不要把真实值写回本文件。

# Web 检索：默认 sources=["web"] 会并发调用 Tavily + Exa。
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
EXA_API_KEY=xxxxxxxxxxxxxxxx

# 可选：Tavily 自建代理。
# TAVILY_BASE_URL=http://localhost:8088
# TAVILY_MASTER_KEY=xxxxxxxxxxxxxxxx

# LLM provider 注册表。Web / 自动化按 runtime_config.json 选择；Python API 可显式配置。
# 只需配置实际会选中的 provider。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.example.com/v1

# 变量名用 DRA_ 前缀，不要改回 DEEPSEEK_BASE_URL：后者是 DSH 的 bootstrap 保留名
# （dsh-app-boot 的 BOOTSTRAP_NAMES），项目 .env 里出现它会让 `dsh web` 从本目录启动
# 时直接抛 "which only the launching environment may set" 而失败。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DRA_DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENCODE_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENCODE_BASE_URL=https://your-opencode-endpoint.example/v1

# 可选：保存证据时由 Jev 联合判断 claim 是否被多段引文及上下文支持；在 Web 设置中启用。
# 仅由后端读取，不进入运行配置、提示词或页面响应。
TYPESAFE_API_KEY=

# 可选：主 Agent 的会话工作区与 Docker 执行。先构建 sandbox_image。
# 执行后端：docker（默认）或 native（macOS 系统沙箱）；网页可覆盖。
DRA_EXECUTION_BACKEND=docker
DRA_EXECUTION_ENABLED=false
# none 禁网；bridge 开启容器联网及保留原件的 download_source 工具。
# DRA_EXECUTION_NETWORK_MODE=none
# DRA_EXECUTION_IMAGE=dra-sandbox:local
# DRA_EXECUTION_IDLE_TIMEOUT_S=600
# DRA_EXECUTION_MAX_CONTAINERS=3
# 本机直接运行无需填写；Web 部署在容器内时须映射到 Docker 宿主的真实目录。
# DRA_EXECUTION_HOST_WORKSPACE_ROOT=/srv/dra/data/runs/.workspaces

CODEX521_API_KEY=sk-xxxxxxxxxxxxxxxx
CODEX521_BASE_URL=https://your-codex521-endpoint.example/v1

# 可选：本机自建的另一个 OpenAI-compatible 端点。
# CODEX_LOCAL_API_KEY=sk-xxxxxxxxxxxxxxxx
# CODEX_LOCAL_BASE_URL=http://localhost:8000/v1

# 可选：eval/drb2 报告评分所用的 OpenAI-compatible 端点。
# DRB2_JUDGE_BASE_URL=https://your-endpoint.example/v1
# DRB2_JUDGE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DRB2_JUDGE_MODEL=gpt-5.5
